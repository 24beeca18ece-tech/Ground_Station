# =============================================================================
#  Ground Control Station -- git ignore rules
# =============================================================================

# --- Python virtual environments --------------------------------------------
# Never commit the venv: it is ~70 MB of platform-specific binaries and is
# rebuilt from requirements.txt in seconds.
.venv/
venv/
env/
ENV/

# --- Python bytecode and caches ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Flight logs (generated at runtime) --------------------------------------
# Telemetry captures are session data, not source. The logs/ directory itself
# IS tracked (via logs/.gitkeep) so the application has somewhere to write on
# a fresh clone -- only its contents are ignored.
logs/*.csv
logs/*.log
logs/*.txt
# Append-only companion of an in-progress flight CSV, and the temp file the
# atomic newest-first rewrite swaps in. Both are runtime state, never source.
logs/*.journal
logs/*.tmp
# The map's on-disk tile cache: up to 500 MB of provider tiles, rebuilt on
# demand, and not ours to redistribute.
logs/tile_cache/

# --- LaTeX build artefacts ---------------------------------------------------
# docs/*.tex and the compiled docs/*.pdf are tracked deliverables; everything
# the TeX engine regenerates on each build is not.
*.aux
*.lof
*.log
*.lot
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.bbl
*.blg
*.idx
*.ilg
*.ind

# --- Raw CAD source (NOT tracked) --------------------------------------------
# voronoi.step is the 12.7 MB AP214 B-rep the CanSat model came from. It is the
# design source of truth, but it is not what the dashboard loads: the runtime
# dependency is assets/cansat_mesh.npz (750 KB), baked from it by
# tools/step_to_mesh.py. Committing the .npz alone means a fresh clone renders
# the real geometry without gmsh installed, and keeps a 12.7 MB blob out of the
# history. Keep the .step in the CAD project / shared drive.
*.step
*.stp

# --- Project assets (MUST stay tracked) --------------------------------------
# The header logos in assets/ are source, not generated output. Nothing above
# excludes them today; this negation is here so that adding a broad rule such
# as "*.png" later cannot silently drop them and leave the header blank.
!assets/
!assets/**

# --- Map configuration and offline tile packs --------------------------------
# NOTE ON ORDER: these rules must stay BELOW the "!assets/**" negation above,
# or that negation would re-include the tile packs. Git applies the last
# matching pattern, so a later rule is what makes these stick.
#
# map_sources.json may name an environment variable holding an API key and may
# carry machine-specific file paths, so the working copy is local. The tracked
# template is map_sources.example.json; copy it to start.
map_sources.json
# The ground station's own coordinates: a physical location, and operator
# preference rather than source.
map_settings.json
# Offline tile packs: tens to hundreds of MB of provider imagery built
# locally, and in most cases not ours to redistribute. The directory itself
# stays tracked via assets/maps/.gitkeep so the app has somewhere to look.
assets/maps/*.mbtiles
*.mbtiles
# Operator-supplied image overlays and their sidecars are local data.
assets/maps/*.png
assets/maps/*.jpg
assets/maps/*.jpeg
# ...but the bundled India overview IS source: a few hundred KB of public
# domain Natural Earth data, so a fresh clone has something on the map.
!assets/maps/india_overview.osmpack.json

# --- Editor / IDE ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Claude Code local settings ----------------------------------------------
# Machine-specific tool permissions; not useful to other team members.
.claude/settings.local.json

# --- Packaging / distribution ------------------------------------------------
build/
dist/
*.egg-info/

# --- OS cruft ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# The 10 km launch pad satellite pack (Sentinel-2 cloudless 2023, EOX,
# CC BY-NC-SA 4.0; see assets/maps/README.md) is committed so the map works
# straight after a clone. This one file only: every other .mbtiles stays
# ignored, and so does its SQLite journal.
!assets/maps/launchpad_s2.mbtiles
assets/maps/launchpad_s2.mbtiles-journal

# Soak runs (tools/soak_guard.py): measurements, not source.
tools/soak_log.csv
tools/.soak.lock
