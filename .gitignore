# =============================================================================
#  Ground Control Station -- git ignore rules
# =============================================================================

# --- Python virtual environments --------------------------------------------
# Never commit the venv: it is ~70 MB of platform-specific binaries and is
# rebuilt from requirements.txt in seconds.
.venv/
venv/
env/
ENV/

# --- Python bytecode and caches ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Flight logs (generated at runtime) --------------------------------------
# Telemetry captures are session data, not source. The logs/ directory itself
# IS tracked (via logs/.gitkeep) so the application has somewhere to write on
# a fresh clone -- only its contents are ignored.
logs/*.csv
logs/*.log
logs/*.txt
# Append-only companion of an in-progress flight CSV, and the temp file the
# atomic newest-first rewrite swaps in. Both are runtime state, never source.
logs/*.journal
logs/*.tmp

# --- LaTeX build artefacts ---------------------------------------------------
# docs/*.tex and the compiled docs/*.pdf are tracked deliverables; everything
# the TeX engine regenerates on each build is not.
*.aux
*.lof
*.log
*.lot
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.bbl
*.blg
*.idx
*.ilg
*.ind

# --- Raw CAD source (NOT tracked) --------------------------------------------
# voronoi.step is the 12.7 MB AP214 B-rep the CanSat model came from. It is the
# design source of truth, but it is not what the dashboard loads: the runtime
# dependency is assets/cansat_mesh.npz (750 KB), baked from it by
# tools/step_to_mesh.py. Committing the .npz alone means a fresh clone renders
# the real geometry without gmsh installed, and keeps a 12.7 MB blob out of the
# history. Keep the .step in the CAD project / shared drive.
*.step
*.stp

# --- Project assets (MUST stay tracked) --------------------------------------
# The header logos in assets/ are source, not generated output. Nothing above
# excludes them today; this negation is here so that adding a broad rule such
# as "*.png" later cannot silently drop them and leave the header blank.
!assets/
!assets/**

# --- Editor / IDE ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Claude Code local settings ----------------------------------------------
# Machine-specific tool permissions; not useful to other team members.
.claude/settings.local.json

# --- Packaging / distribution ------------------------------------------------
build/
dist/
*.egg-info/

# --- OS cruft ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
